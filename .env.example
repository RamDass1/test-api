# Copy to .env before docker compose up.
# Generate secret with: openssl rand -hex 32
JWT_SECRET=local-dev-only-change-me-32bytes-min
JWT_TTL=24h
HTTP_ADDR=:8080
HTTP_PORT=8080
MYSQL_DSN=app:app@tcp(127.0.0.1:3306)/test_api
MYSQL_DATABASE=test_api
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
REDIS_ADDR=127.0.0.1:6379
REDIS_PORT=6379
CACHE_TASK_LIST_TTL=5m